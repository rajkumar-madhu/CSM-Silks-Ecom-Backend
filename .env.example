# Google Sign-In (optional, id_token redirect — no client secret required):
# 1. Create an OAuth Web client in Google Cloud Console.
# 2. Add Authorized redirect URIs:
#    http://localhost:5173/auth/google/callback
#    http://127.0.0.1:5173/auth/google/callback
# 3. Backend .env:
#    GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
#    GOOGLE_OAUTH_ENABLED=True
# 4. Optional frontend mirror:
#    frontend/.env.local -> VITE_GOOGLE_CLIENT_ID=<same client id>
# GOOGLE_CLIENT_SECRET is only needed for authorization-code exchange (optional).

# Production minimums checked by `python backend/manage.py check --deploy`:
# APP_ENV=production
# DEBUG=False
# SECRET_KEY=<long-random-secret>
# DATABASE_URL=postgres://csm:<password>@db:5432/csm_silks
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CHANNEL_LAYER_BACKEND=redis
# ALLOWED_HOSTS=your-domain.com
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-domain.com
# BEHIND_REVERSE_PROXY=True
# USE_X_FORWARDED_PROTO=True
# SECURE_SSL_REDIRECT=False
# RAZORPAY_KEY_ID=<live-or-test-key-id>
# RAZORPAY_KEY_SECRET=<live-or-test-key-secret>
# RAZORPAY_WEBHOOK_SECRET=<webhook-secret>
# OTP_EMAIL_ENABLED=True
# RESEND_API_KEY=<resend-key>
# RESEND_FROM_EMAIL=orders@your-domain.com
# STORE_CONTACT_EMAIL=orders@your-domain.com
# NOTIFICATION_EMAIL_ENABLED=True
# DEFAULT_COURIER_PROVIDER=manual
